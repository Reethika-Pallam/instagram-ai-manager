# Instagram Graph API Configuration
INSTAGRAM_ACCESS_TOKEN=your_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_business_account_id_here
INSTAGRAM_API_VERSION=v18.0

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Microsoft Fabric Configuration
FABRIC_WORKSPACE_ID=your_workspace_id_here
FABRIC_DATASET_NAME=instagram_performance
FABRIC_TENANT_ID=your_tenant_id_here
FABRIC_CLIENT_ID=your_client_id_here
FABRIC_CLIENT_SECRET=your_client_secret_here
FABRIC_API_ENDPOINT=https://api.powerbi.com/v1.0/myorg

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Toggles
ENABLE_ANALYTICS=true
ENABLE_PREDICTIONS=true
ENABLE_RECOMMENDATIONS=true
ENABLE_CAPTION_GENERATION=true
ENABLE_FABRIC_INTEGRATION=true

# API Settings
API_TIMEOUT=30
MAX_RETRIES=3
REST_PERIOD_SECONDS=60

# Caption Generation Settings
CAPTION_OPTIONS_COUNT=3
DEFAULT_CAPTION_TONE=casual

# Knowledge Graph Settings
KNOWLEDGE_GRAPH_ENABLED=true
KNOWLEDGE_GRAPH_MIN_EDGES=5
